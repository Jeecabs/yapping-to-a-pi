{
  "name": "yapping-to-a-pi",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "description": "computer, listen: on-device macOS dictation with a Pi extension.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jeecabs/yapping-to-a-pi.git"
  },
  "keywords": [
    "pi-package",
    "dictation",
    "speech-to-text",
    "macos",
    "on-device"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "postinstall": "node scripts/build-native.mjs",
    "build:native": "node scripts/build-native.mjs",
    "build:app": "node scripts/build-app.mjs",
    "open:app": "open 'native/.build/computer, listen.app'",
    "doctor:app": "'native/.build/computer, listen.app/Contents/MacOS/yapping-to-a-pi' --diagnose",
    "check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:native": "xcrun swift test --package-path native",
    "doctor:native": "native/.build/YappingToAPiHelper.app/Contents/MacOS/yapping-to-a-pi-helper --doctor",
    "verify": "pnpm run check && pnpm run test && pnpm run test:native && pnpm run build:app && pnpm run doctor:native && pnpm run doctor:app",
    "release:app": "node scripts/release-app.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.0",
    "@earendil-works/pi-tui": ">=0.85.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
